<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dlg_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/watch_card"
    android:padding="12dp">

    <TextView
        android:id="@+id/dlg_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="输入"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#1C1B1F" />

    <EditText
        android:id="@+id/dlg_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="40dp"
        android:layout_marginTop="8dp"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:textSize="14sp"
        android:singleLine="true"
        android:background="@drawable/watch_edittext" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="8dp">
        <TextView
            android:id="@+id/dlg_btn_negative"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="取消"
            android:textColor="#666"
            android:textSize="13sp"
            android:textStyle="bold"
            android:padding="8dp" />
        <TextView
            android:id="@+id/dlg_btn_positive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="确定"
            android:textColor="#388E3C"
            android:textSize="13sp"
            android:textStyle="bold"
            android:padding="8dp"
            android:layout_marginLeft="10dp" />
    </LinearLayout>
</LinearLayout>
