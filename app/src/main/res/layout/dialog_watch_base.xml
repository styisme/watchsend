<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dlg_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1A1A1A"
    android:paddingTop="24dp"
    android:paddingBottom="24dp"
    android:paddingLeft="16dp"
    android:paddingRight="16dp">

    <!-- 顶部图标：圆圈 i -->
    <TextView
        android:id="@+id/dlg_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/dlg_icon_bg"
        android:gravity="center"
        android:text="i"
        android:textColor="#000000"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/dlg_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="标题"
        android:textSize="15sp"
        android:textColor="#FFFFFF"
        android:gravity="center" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:maxHeight="140dp"
        android:scrollbars="none">
        <LinearLayout
            android:id="@+id/dlg_content_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="20dp">

        <TextView
            android:id="@+id/dlg_btn_negative"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/dlg_btn_neg"
            android:gravity="center"
            android:text="×"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:clickable="true"
            android:focusable="true"/>

        <View
            android:layout_width="24dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/dlg_btn_positive"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/dlg_btn_pos"
            android:gravity="center"
            android:text="✓"
            android:textColor="#000000"
            android:textSize="28sp"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>
</LinearLayout>
