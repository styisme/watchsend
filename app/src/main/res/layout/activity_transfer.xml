<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_transfer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F8">

    <LinearLayout android:id="@+id/layout_confirm"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:gravity="center" android:padding="10dp"
        android:visibility="gone">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="📱" android:textSize="36sp" android:paddingBottom="6dp"/>
        <TextView android:id="@+id/tv_sender_name"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#1C1B1F" android:textSize="16sp" android:textStyle="bold"/>
        <TextView android:id="@+id/tv_sender_type"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#FFFFFF" android:background="@drawable/bg_device_tag"
            android:paddingLeft="6dp" android:paddingRight="6dp"
            android:paddingTop="2dp" android:paddingBottom="2dp"
            android:layout_marginTop="4dp" android:textSize="10sp"/>
        <TextView android:id="@+id/tv_want_to_send"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#49454F" android:textSize="11sp" android:layout_marginTop="6dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="12dp">
            <Button android:id="@+id/btn_reject"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="42dp"
                android:textColor="#FFFFFF" android:textSize="12sp"
                android:background="@drawable/btn_reject" android:layout_marginRight="4dp"/>
            <Button android:id="@+id/btn_accept"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="42dp"
                android:textColor="#FFFFFF" android:textSize="12sp"
                android:background="@drawable/btn_accept" android:layout_marginLeft="4dp"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:id="@+id/layout_progress"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="8dp"
        android:visibility="gone">

        <TextView android:id="@+id/tv_title"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="14sp" android:textColor="#1C1B1F"/>

        <TextView android:id="@+id/tv_save_dir"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="9sp" android:textColor="#888"
            android:visibility="gone" android:layout_marginTop="2dp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/watch_card"
            android:orientation="horizontal" android:padding="8dp"
            android:gravity="center_vertical" android:layout_marginTop="6dp">
            <TextView android:id="@+id/tv_file_icon"
                android:layout_width="30dp" android:layout_height="30dp"
                android:textSize="16sp" android:gravity="center"
                android:background="#C8E6C9"/>
            <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:layout_marginLeft="8dp">
                <TextView android:id="@+id/tv_file_name"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="11sp" android:textColor="#1C1B1F"
                    android:singleLine="true" android:ellipsize="middle"/>
                <TextView android:id="@+id/tv_file_status"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="9sp" android:textColor="#388E3C"
                    android:visibility="gone" android:layout_marginTop="2dp"/>
                <ProgressBar android:id="@+id/pb_file"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:max="100" android:layout_marginTop="2dp"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/watch_card"
            android:orientation="vertical" android:padding="8dp" android:layout_marginTop="6dp">
            <TextView android:id="@+id/tv_total_title"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="11sp" android:textColor="#1C1B1F"/>
            <ProgressBar android:id="@+id/pb_total"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:max="100" android:layout_marginTop="2dp"/>
            <TextView android:id="@+id/tv_speed_info"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="9sp" android:textColor="#666"
                android:layout_marginTop="3dp" android:lineSpacingExtra="1dp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="end" android:layout_marginTop="8dp">
            <Button android:id="@+id/btn_cancel"
                android:layout_width="wrap_content" android:layout_height="34dp"
                android:textColor="#B3261E"
                android:background="@drawable/btn_cancel_transfer" android:minHeight="0dp"
                android:textSize="10sp" android:paddingLeft="10dp" android:paddingRight="10dp"/>
            <Button android:id="@+id/btn_done"
                android:layout_width="wrap_content" android:layout_height="34dp"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_accept" android:visibility="gone"
                android:minHeight="0dp" android:layout_marginLeft="6dp"
                android:textSize="10sp" android:paddingLeft="10dp" android:paddingRight="10dp"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
